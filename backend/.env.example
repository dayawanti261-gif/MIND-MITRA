# Copy to .env and fill in values. Do NOT commit .env.

# Supabase Storage (media bucket: mind-mitra-media)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Firebase Admin — prefer env JSON on Railway; local can use serviceAccountKey.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# Saathi AI agent via OpenRouter (optional — REST API starts without this)
# Use FREE models only: openrouter/free or model IDs ending with :free
# Comma-separated list; each model is tried once per request with automatic fallback.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free
# Legacy single-model variable (used only when OPENROUTER_MODELS is unset):
# OPENROUTER_MODEL=openrouter/free
